# ===== 运行 / 缓存目录 =====
# 注意：以下目录规则均用前导 / 锚定到仓库根，避免误伤嵌套的同名目录。
# （曾因裸写 "log/" 和 "data/" 误匹配 third_party/.../absl/log 头文件目录
#   和 static/wizard/sample_data 示例数据，已修正。）
/logs/
/pgdata/
/venv/
/.venv/
node_modules/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# ===== 编辑器 / IDE / 工具残留 =====
.agents/
.claude/
.codex/
.devcontainer/
.history/
.idea/
.vscode/
CMakeSettings.json
pnpm-lock.yaml

# ===== 本地临时构建目录 =====
/build/
/cmake-build-*/

# ===== 说明 =====
# bin/ 与 third_party/ 是随镜像发布的预编译产物（libccAPPS.so、or-tools），
# 本地没有完整工具链无法重建，故保留在版本控制内，不要忽略。
