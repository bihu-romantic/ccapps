# —— 数据库 ——
POSTGRES_DB=ccapps
POSTGRES_USER=ccapps
POSTGRES_PASSWORD=replace-with-db-password
POSTGRES_MAX_CONNECTIONS=40
AIDT_PGDATA=./data/pgdata

# —— ccAPPS Web / Worker ——
# 本地已有镜像可用 ccapps-aidt:app；生产建议用 GHCR：
# CCAPPS_IMAGE=ghcr.io/bihu-romantic/ccapps-aidt-app:latest
# CCAPPS_WORKER_IMAGE=ghcr.io/bihu-romantic/ccapps-aidt-worker:latest
CCAPPS_IMAGE=ccapps-aidt:app
CCAPPS_WORKER_IMAGE=ccapps-aidt:worker
CCAPPS_HOST_PORT=8011
DJANGO_SECRET_KEY=replace-with-django-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SETTINGS_MODULE=ccAPPSdb.settings
GUNICORN_WORKERS=2
# 空库首次启动保留 true；导入已有库后改为 false
CCAPPS_BOOTSTRAP=true

# —— MRP MCP ——
MCP_HOST_PORT=9005
CCAPPS_BASE_URL=http://app:8001
CCAPPS_API_TOKEN=replace-with-ccapps-api-token
DEFAULT_SCENARIO=scenario1
# 客户端 Authorization: Bearer <MCP_AUTH_TOKEN>；可留空（仅内网）
MCP_AUTH_TOKEN=replace-with-mcp-bearer-token
