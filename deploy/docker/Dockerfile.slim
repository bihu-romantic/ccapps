# 精简运行镜像 v2：基于 ubuntu:24.04（glibc 2.39，匹配预编译引擎）
# 不含 cmake/g++/node 等编译工具；引擎 + or-tools 已预编译，运行库齐全。
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DJANGO_SETTINGS_MODULE=ccAPPSdb.settings \
    CCAPPS_APP=/app \
    CCAPPS_CONFIGDIR=/app/config \
    CCAPPS_LOGDIR=/var/lib/ccapps/logs \
    CCAPPS_STATIC=/var/lib/ccapps/static \
    PATH="/opt/venv/bin:$PATH" \
    LD_LIBRARY_PATH="/app/third_party/or-tools/lib"

# 只装运行时：python3.12 + 运行动态库（非 -dev），不装编译器
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      python3 python3-venv python3-pip ca-certificates \
      libxerces-c3.2 libpq5 libssl3 libstdc++6 postgresql-client locales \
    && sed -i 's/# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen \
    && locale-gen \
    && python3 -m venv /opt/venv \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
# 先装依赖（层缓存），用国内源；gunicorn 一并装
COPY .container-requirements-clean.txt /tmp/req.txt
RUN /opt/venv/bin/pip install --no-cache-dir --upgrade pip \
      -i https://pypi.tuna.tsinghua.edu.cn/simple \
 && /opt/venv/bin/pip install --no-cache-dir -r /tmp/req.txt gunicorn \
      -i https://pypi.tuna.tsinghua.edu.cn/simple

# 拷代码（.dockerignore 已排除 .git/pgdata/logs/venv/fixtures 等）
COPY . /app
RUN mkdir -p /app/config /var/lib/ccapps/logs /var/lib/ccapps/static \
    && cp /app/djangosettings.py /app/config/djangosettings.py \
    && chmod +x /app/deploy/docker/entrypoint.sh \
    && echo /app/third_party/or-tools/lib > /etc/ld.so.conf.d/ortools.conf \
    && ldconfig \
    && /opt/venv/bin/python -c "import ccAPPS; print('engine smoke OK')"

EXPOSE 8001
ENTRYPOINT ["/app/deploy/docker/entrypoint.sh"]
